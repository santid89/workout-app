# Firebase web config (Vite exposes only VITE_*-prefixed vars to the client).
#
# These values are PUBLIC and safe to commit — Firebase secures data with
# security rules (firestore.rules), not by hiding this config. The real values
# for the workouts-app-bd756 project live in the committed `.env` file so the
# build works out of the box; copy this file to `.env.local` only if you want
# to point a local build at a different Firebase project.
#
# Grab a config from:
#   Firebase console → ⚙ Project settings → "Your apps" → Web app → SDK setup

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

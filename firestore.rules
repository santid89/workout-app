rules_version = '2';

// Workout-app data model: each signed-in user owns a private collection of
// workout logs at  users/{uid}/logs/{logId}.  A user can only ever read or
// write documents under their own uid — nobody can see anyone else's history.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

rules_version = '2';

// Cloud Storage layout
// --------------------
//  users/{uid}/food/{file} — a user's private food photos. Readable/writable
//                            only by that signed-in user. Cloud Functions use
//                            the Admin SDK and bypass these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/food/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
